{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Azure.Cosmos": "Warning",
      "DNV.Outbox": "Information"
    }
  },
  "AllowedHosts": "*",

  "Cosmos": {
    "Endpoint": "https://localhost:8081/",

    // The Azure Cosmos DB Emulator's key. It is fixed, identical on every machine and published
    // in Microsoft's documentation, so it is not a secret and is safe to commit.
    //
    // Never do this against a real account. Azure Cosmos supports Entra ID, so production code
    // should construct the client with DefaultAzureCredential and no key at all:
    //
    //     new CosmosClient(endpoint, new DefaultAzureCredential())
    //
    // and grant the app the "Cosmos DB Built-in Data Contributor" role.
    "Key": "C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==",

    // The emulator serves a self-signed certificate. Development only - see Program.cs.
    "TrustSelfSignedCertificate": true,

    "DatabaseId": "sales",
    "ContainerId": "orders",
    "PartitionKeyPath": "/tenantId"
  },

  "Outbox": {
    "ReceiverEndpoint": "http://localhost:5100/events"
  }
}
