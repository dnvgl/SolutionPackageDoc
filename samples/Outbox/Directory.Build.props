<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The Outbox samples consume the library from the sibling SolutionPackage repository.
    Override with -p:SolutionPackageRoot=<path> if the two repos are not siblings.
  -->
  <PropertyGroup>
    <SolutionPackageRoot Condition="'$(SolutionPackageRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\SolutionPackage'))</SolutionPackageRoot>
    <OutboxSrc>$(SolutionPackageRoot)\src\Outbox</OutboxSrc>
  </PropertyGroup>

  <!--
    Microsoft.Data.SqlClient 7.1.1 (the latest at time of writing, pinned by the library in
    SolutionPackage/src/Directory.Packages.props) drags in System.Security.Cryptography.Pkcs
    9.0.18, which carries a known high-severity advisory (GHSA-846f-f764-76mx). These samples
    build with TreatWarningsAsErrors, so NuGet audit turns that into a build error.

    Pin the patched version transitively. Remove this once Microsoft.Data.SqlClient ships a
    release that no longer resolves a vulnerable Pkcs.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <Target Name="ValidateSolutionPackageRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(OutboxSrc)\Core\DNV.Outbox.Core.csproj')"
           Text="The DNV Outbox library was not found at '$(OutboxSrc)'. The SolutionPackage and SolutionPackageDoc repositories must be checked out as siblings, or pass -p:SolutionPackageRoot=&lt;path-to-SolutionPackage&gt;." />
  </Target>

</Project>
