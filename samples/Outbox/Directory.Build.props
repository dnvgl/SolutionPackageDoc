<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The Outbox samples consume the library from the sibling SolutionPackage repository.
    Override with -p:SolutionPackageRoot=<path> if the two repos are not siblings.
  -->
  <PropertyGroup>
    <SolutionPackageRoot Condition="'$(SolutionPackageRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\SolutionPackage'))</SolutionPackageRoot>
    <OutboxSrc>$(SolutionPackageRoot)\src\Outbox</OutboxSrc>
  </PropertyGroup>

  <!--
    DNV.Outbox.SqlServer references a patched System.Security.Cryptography.Pkcs directly, so the
    samples inherit it through their project references. No workaround is needed here.
  -->

  <Target Name="ValidateSolutionPackageRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(OutboxSrc)\Core\DNV.Outbox.Core.csproj')"
           Text="The DNV Outbox library was not found at '$(OutboxSrc)'. The SolutionPackage and SolutionPackageDoc repositories must be checked out as siblings, or pass -p:SolutionPackageRoot=&lt;path-to-SolutionPackage&gt;." />
  </Target>

</Project>
