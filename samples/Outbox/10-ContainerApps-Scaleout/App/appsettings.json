{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Debug, deliberately. The dispatcher logs "Claimed {Count} deliveries for {InstanceId}"
      // at Debug, and that line - one per replica, in Log Analytics - is the evidence that the
      // work was actually shared rather than done entirely by one replica.
      "DNV.Outbox.Hosting": "Debug"
    }
  },
  "ConnectionStrings": {
    // Replaced by the ConnectionStrings__Sales environment variable in Azure, which points at the
    // Azure SQL database and authenticates as the container app's managed identity.
    "Sales": "Server=(localdb)\\MSSQLLocalDB;Database=OutboxSample10;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Dapr": {
    "PubSubName": "order-pubsub",
    "TopicName": "scaleout-events"
  }
}
