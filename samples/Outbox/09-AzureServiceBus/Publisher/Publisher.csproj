<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Outbox.Samples.AzureServiceBus</RootNamespace>
    <AssemblyName>Outbox.Samples.AzureServiceBus</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Outbox.Samples.Domain\Outbox.Samples.Domain.csproj" />
    <ProjectReference Include="$(OutboxSrc)\SqlServer\DNV.Outbox.SqlServer.csproj" />
    <ProjectReference Include="$(OutboxSrc)\AzureServiceBus\DNV.Outbox.AzureServiceBus.csproj" />
    <ProjectReference Include="$(OutboxSrc)\Hosting\DNV.Outbox.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The library takes a ServiceBusClient from DI and never constructs one, so it has no opinion
      about credentials. Azure.Identity is referenced here, by the application, because choosing
      how to authenticate is the application's job.
    -->
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
  </ItemGroup>

</Project>
