{
  "ConnectionStrings": {
    // The outbox store stays on local SQL Server. Only the destination is in Azure, which keeps
    // the running cost of this sample to the Service Bus namespace alone.
    "Sales": "Server=.\\SQLEXPRESS;Database=OutboxSample09;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "ServiceBus": {
    // Replace with your own namespace if you provisioned into a different subscription:
    // the name is printed by infra\provision.ps1.
    "Namespace": "sb-outbox-yoki6oss7i6l2.servicebus.windows.net",
    "Queue": "order-events"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Messaging.ServiceBus": "Warning",
      "Azure.Identity": "Warning"
    }
  }
}
